{
  "autodiscover": true,
  "autodiscoverFilter": [
    "homelab/*"
  ],
  "cachePrivatePackages": true,
  "detectHostRulesFromEnv": true,
  "endpoint": "https://forge.macopla.com",
  "onboardingConfig": {
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "local>homelab/renovate-config"
    ]
  },
  "persistRepoData": true,
  "platform": "forgejo",
  "repositoryCache": "enabled"
}
