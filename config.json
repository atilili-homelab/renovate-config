{
  "autodiscover": true,
  "autodiscoverFilter": [
    "homelab/*",
    "yoann/*"
  ],
  "cachePrivatePackages": true,
  "detectHostRulesFromEnv": true,
  "endpoint": "https://forge.macopla.com",
  "allowedCommands": [
    "^nix --extra-experimental-features 'nix-command flakes' run \\.#write-flake$",
    "^nix --extra-experimental-features 'nix-command flakes' flake lock$"
  ],
  "onboardingConfig": {
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "local>homelab/renovate-config"
    ]
  },
  "persistRepoData": true,
  "platform": "forgejo",
  "repositoryCache": "enabled",
  "semanticCommits": "enabled"
}
