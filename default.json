{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Paris",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "nix": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":disableRateLimiting",
    ":separateMultipleMajorReleases"
  ],
  "customManagers": [
    {
      "description": "Versions annotées : # renovate: datasource=… depName=… [registryUrl=…] [extractVersion=…] au-dessus de la variable",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[\\w.-]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "collection homelab.base : tags lus par l'api de la forge",
      "matchPackageNames": [
        "ssh://git@forge.macopla.com:2222/homelab/ansible.git"
      ],
      "overrideDatasource": "forgejo-tags",
      "overridePackageName": "homelab/ansible",
      "registryUrls": [
        "https://forge.macopla.com"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge des flake.lock",
      "matchManagers": [
        "nix"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Automerge pin",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": null,
      "automerge": true
    },
    {
      "description": "Digests : pas d'automerge",
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Automerge de mes propres images",
      "matchUpdateTypes": [
        "digest"
      ],
      "matchPackageNames": [
        "forge.macopla.com/**"
      ],
      "automerge": true
    },
    {
      "description": "Automerge patch et minor",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "minimumReleaseAge": null,
    "schedule": [
      "* 4 * * 6"
    ]
  }
}
